# Copy this file to .env.local and fill in your credentials

# Neon Postgres connection string (server-only - never prefix with NEXT_PUBLIC_)
NEON_DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Vercel Blob read-write token for image storage (server-only)
BLOB_READ_WRITE_TOKEN=your-blob-read-write-token-here

# Mapbox token
# Get this from: https://account.mapbox.com/access-tokens
NEXT_PUBLIC_MAPBOX_TOKEN=your-mapbox-token-here
